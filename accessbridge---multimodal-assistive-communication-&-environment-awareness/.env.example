# ==============================================================================
# AccessBridge - Environment Configuration Template
# Place actual secrets only in backend .env (NEVER commit secrets to git).
# ==============================================================================

# 1. Google Gemini API Keys
# Supports comma-separated keys for automatic round-robin rotation and cooldown on 429/quota limits
# Example: GEMINI_API_KEY=AIzaSyA...,AIzaSyB...,AIzaSyC...
GEMINI_API_KEY=""

# 2. Optional Premium Text-to-Speech (TTS)
# If provided, enables cloud neural female voices with audio amplitude lip-sync
# Leave empty to use client browser speech synthesis (Microsoft Neerja, Pallavi, etc.)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # Rachel / Soft female default

GOOGLE_TTS_API_KEY=""

# 3. Speech-to-Text (STT) Configuration
# faster-whisper runs on CPU with INT8 quantization by default
WHISPER_MODEL_SIZE="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# 4. Host & Port Configuration
HOST="0.0.0.0"
PORT=8000
APP_URL="http://localhost:5173"
